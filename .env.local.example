NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (NEVER expose to the browser) — used by the email ingest API route
SUPABASE_SERVICE_ROLE_KEY=
# Optional; falls back to NEXT_PUBLIC_SUPABASE_URL if unset
SUPABASE_URL=
# Shared secret required in the x-ingest-secret header on /api/amazon-email-ingest
AMAZON_INGEST_SECRET=

# --- Graph mailbox poller (/api/amazon-ingest-poll) ---
# Azure AD app registration with Mail.Read APPLICATION permission (admin-consented)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Vercel Cron auth — set this in Vercel; cron sends "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Comma-separated mailboxes to poll (default: vihan@ + purchasing@)
INGEST_MAILBOXES=vihan@techniline.org,purchasing@techniline.org
# How far back each poll looks (hours); overlap + dedup makes this self-healing
INGEST_LOOKBACK_HOURS=48
