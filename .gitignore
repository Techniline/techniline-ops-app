# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# keep the example template tracked (no real secrets)
!.env.local.example

# vercel
.vercel

# claude local files (do not commit)
.claude/settings.local.json

# supabase CLI local artifacts
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

.claude/

# local email drafts
docs/*.eml

# stray credential / screenshot files at repo root (never commit secrets)
/Client identifier*.txt
/amazon law code.png
/*.png

.env*
